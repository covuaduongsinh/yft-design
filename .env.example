# Biến môi trường của backend yft-design.
# Chạy trên máy: sao chép thành server/.env. Docker/Dokploy: sao chép thành .env
# ở thư mục gốc (hoặc nhập ở tab Environment của Dokploy).
# Mọi biến đều có giá trị mặc định an toàn; chỉ cần đặt những dòng muốn đổi.

# ---------- Bắt buộc khi triển khai thật ----------
# Địa chỉ công khai của trang, không có dấu / ở cuối.
SITE_URL=https://design.example.com
# Quản trị viên đầu tiên. Chỉ có tác dụng khi hệ thống CHƯA có quản trị viên nào;
# các lần khởi động sau bị bỏ qua (không đặt lại mật khẩu). Mật khẩu tối thiểu 8 ký tự.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Số proxy tin cậy đứng trước server. Dokploy (Traefik) = 1; chạy trực tiếp = 0.
TRUST_PROXY_HOPS=1

# ---------- Máy chủ ----------
# HOST=127.0.0.1            # image Docker đã đặt sẵn 0.0.0.0
# PORT=8788
# DATA_DIR=data             # nơi chứa yft.db, media/, backups/ (Docker: /data)
# STATIC_DIR=               # thư mục bản build frontend để server tự phục vụ (Docker: /app/web)

# ---------- Tài khoản và đăng nhập ----------
# REGISTRATION_OPEN=true    # false = chỉ quản trị viên tạo được tài khoản
# CAPTCHA_ENABLED=true      # captcha ảnh ở form đăng nhập/đăng ký
# PASSWORD_MIN_LENGTH=8
# SESSION_TTL_DAYS=30       # phiên tự gia hạn mỗi lần dùng
# LOGIN_MAX_FAILURES=5      # số lần sai trước khi khoá tạm (theo cặp email + IP)
# LOGIN_LOCK_MINUTES=15
# AUTH_RATE_PER_MINUTE=30   # số request xác thực mỗi phút cho một IP; 0 = không giới hạn

# ---------- Email (tuỳ chọn, mặc định tắt) ----------
# Khi đặt SMTP_URL và REQUIRE_EMAIL_OTP=true, đăng ký phải nhập mã gửi qua email.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=yft-design <no-reply@example.com>
# REQUIRE_EMAIL_OTP=false

# ---------- Thiết kế ----------
# MAX_DESIGN_DOCUMENT_BYTES=20971520   # dung lượng một tài liệu sau khi giải nén (20 MiB)
# MAX_DESIGNS_PER_USER=500
# TRASH_RETENTION_DAYS=30              # thiết kế trong thùng rác bị xoá hẳn sau số ngày này
# AUTO_VERSION_INTERVAL_MINUTES=10     # khoảng cách tối thiểu giữa hai phiên bản tự động
# MAX_AUTO_VERSIONS=50
# MAX_MANUAL_VERSIONS=100

# ---------- Ảnh và font tải lên ----------
# MAX_UPLOAD_BYTES=20971520            # một file ảnh (20 MiB)
# MAX_IMAGE_PIXELS=64000000            # chặn ảnh "bom giải nén"
# USER_STORAGE_QUOTA_BYTES=1073741824  # hạn mức mỗi người dùng (1 GiB)
# UPLOAD_RATE_PER_MINUTE=120
# MAX_FONT_BYTES=15728640

# ---------- Kho ảnh Pixabay (tuỳ chọn, mặc định tắt) ----------
# Có khoá thì tab ảnh/minh hoạ tìm thêm trên Pixabay; ảnh được chèn sẽ tải về máy chủ.
# PIXABAY_API_KEY=

# ---------- Tách nền ảnh (tuỳ chọn, mặc định tắt) ----------
# Địa chỉ dịch vụ rembg nội bộ, vd http://rembg:7000 (xem docs/backend).
# MATTING_URL=
# MATTING_TIMEOUT_SECONDS=120

# ---------- Sao lưu ----------
# BACKUP_ENABLED=false                 # true = mỗi đêm chép CSDL vào DATA_DIR/backups
# BACKUP_KEEP_DAYS=7
